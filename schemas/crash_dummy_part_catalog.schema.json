{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-breeding.invalid/schemas/crash_dummy_part_catalog.schema.json",
  "title": "Go.Breeding Crash Dummy Part Catalog",
  "type": "object",
  "required": ["schema_version", "forms", "views", "morph_contract", "foundations", "part_definitions"],
  "properties": {
    "schema_version": {"type": "string"},
    "forms": {"type": "array", "items": {"enum": ["neutral", "masc", "femm"]}, "uniqueItems": true},
    "views": {"type": "array", "items": {"enum": ["front", "back", "side", "three_quarter"]}, "uniqueItems": true},
    "morph_contract": {
      "type": "object",
      "required": ["principle", "composition_order", "channels"],
      "properties": {
        "principle": {"type": "string"},
        "composition_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "channels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "default", "range", "target_parts"],
            "properties": {
              "kind": {"enum": ["structural", "soft_form"]},
              "default": {"type": "number"},
              "range": {
                "type": "array",
                "prefixItems": [{"type": "number"}, {"type": "number"}],
                "minItems": 2,
                "maxItems": 2
              },
              "target_parts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
              "supports_secondary_motion": {"type": "boolean"}
            }
          }
        }
      }
    },
    "foundations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "required_parts"],
        "properties": {
          "display_name": {"type": "string"},
          "required_parts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "replaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "part_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "family", "views", "mirrorable", "repeatable", "mount", "status"],
        "properties": {
          "display_name": {"type": "string"},
          "family": {"type": "string"},
          "forms": {"type": "array", "items": {"enum": ["neutral", "masc", "femm"]}, "uniqueItems": true},
          "views": {"type": "array", "items": {"enum": ["front", "back", "side", "three_quarter"]}, "uniqueItems": true},
          "mirrorable": {"type": "boolean"},
          "repeatable": {"type": "boolean"},
          "mount": {"type": "string"},
          "status": {"enum": ["initial_svg", "reserved", "contract_only"]},
          "replaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
